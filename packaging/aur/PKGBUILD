# Maintainer: ylkhn1 <ylkhn1@users.noreply.github.com>
pkgname=sshdeck
pkgver=0.4.0
pkgrel=1
pkgdesc="Lightweight native SSH client: SFTP file tree, terminal and database client in one window"
arch=('x86_64' 'aarch64')
url="https://github.com/ylkhn1/sshdeck"
license=('MIT')
depends=(
  'gcc-libs'
  'glib2'
  'glibc'
  'graphene'
  'gtk4'
  'libadwaita'
  'openssl'
  'pango'
  'sqlite'
  'vte4'
  'openssh'
  'xdg-utils'
)
makedepends=('cargo' 'git')
# Исходники — по тегу из git: целостность проверяет git по хешам коммитов,
# поэтому контрольную сумму после нового тега пересчитывать не нужно.
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

# Сборка из PKGBUILD сама себя не обновляет: о новой версии программа
# только сообщает и показывает, как пересобрать пакет.
build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export SSHDECK_INSTALL_KIND=aur
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export SSHDECK_INSTALL_KIND=aur
  cargo test --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/sshdeck "$pkgdir/usr/bin/sshdeck"
  install -Dm644 data/dev.sshdeck.App.desktop "$pkgdir/usr/share/applications/dev.sshdeck.App.desktop"
  install -Dm644 data/dev.sshdeck.App.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.sshdeck.App.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

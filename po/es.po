msgid_plural "Folder “{1}”, its subfolders and {0} saved connections in them will be removed from the list. Nothing changes on the servers."
msgstr[0] "La carpeta «{1}», sus subcarpetas y {0} conexión guardada en ellas desaparecerán de la lista. En los servidores no cambia nada."
msgstr[1] "La carpeta «{1}», sus subcarpetas y las {0} conexiones guardadas en ellas desaparecerán de la lista. En los servidores no cambia nada."

# --- ssh ---

msgid "ssh -G did not answer in time"
msgstr "ssh -G no respondió a tiempo"

msgid "ssh -G failed: {}"
msgstr "Error de ssh -G: {}"

msgid "Your key {} will be used: it is set by IdentityFile for this host."
msgstr "Se usará tu clave {}: es la indicada en IdentityFile para este host."

msgid "The key {} set by IdentityFile for this host does not exist yet: it will be created (ed25519, no passphrase)."
msgstr "La clave {} indicada en IdentityFile para este host todavía no existe: se creará (ed25519, sin frase de contraseña)."

msgid "Key Installed, but Login Still Fails"
msgstr "La clave está instalada, pero el inicio de sesión sigue fallando"

msgid "Key {} is in ~/.ssh/authorized_keys on {}, but a test login with it still failed ({}). The server’s sshd may read keys from a different file (AuthorizedKeysFile in /etc/ssh/sshd_config) or ignore ~/.ssh because its permissions are too open."
msgstr "La clave {} está en ~/.ssh/authorized_keys en {}, pero un inicio de sesión de prueba con ella falló ({}). Puede que el sshd del servidor lea las claves de otro archivo (AuthorizedKeysFile en /etc/ssh/sshd_config) o ignore ~/.ssh porque sus permisos son demasiado amplios."

msgid "Following cd Updated"
msgstr "Seguimiento de cd actualizado"

msgid "The old sshdeck-cwd snippet was replaced with a new version that also handles folders with spaces and non-ASCII names. It takes effect after you log in again: close the tab and reconnect."
msgstr "El fragmento sshdeck-cwd antiguo se sustituyó por una versión nueva que también admite carpetas con espacios y caracteres no ASCII en el nombre. Funcionará después de volver a iniciar sesión: cierra la pestaña y vuelve a conectarte."

msgid "The terminal is now on {}; the file panel stays on {}"
msgstr "El terminal está ahora en {}; el panel de archivos se queda en {}"

# --- tunnels ---

msgid "Local"
msgstr "Local"

msgid "Remote"
msgstr "Remoto"

msgid "Dynamic (SOCKS)"
msgstr "Dinámico (SOCKS)"

msgid "Enter the port to listen on (1–65535)"
msgstr "Indica el puerto en el que escuchar (1–65535)"

msgid "Enter the destination host, for example localhost"
msgstr "Indica el host de destino, por ejemplo localhost"

msgid "Enter the destination port (1–65535)"
msgstr "Indica el puerto de destino (1–65535)"

msgid "“{}” is not a valid forward: use -L [address:]port:host:port, -R [address:]port:host:port or -D [address:]port"
msgstr "«{}» no es un reenvío válido: usa -L [dirección:]puerto:host:puerto, -R [dirección:]puerto:host:puerto o -D [dirección:]puerto"

msgid "“{}” is not a valid host name or address"
msgstr "«{}» no es un nombre de host ni una dirección válidos"

msgid "“*” can only be used as the address to listen on"
msgstr "«*» solo se puede usar como dirección en la que escuchar"

msgid "Write the IPv6 address “{}” in square brackets: [{}]"
msgstr "Escribe la dirección IPv6 «{}» entre corchetes: [{}]"

msgid "“{}” is listed twice"
msgstr "«{}» aparece dos veces"

msgid "“{}” and “{}” use the same port"
msgstr "«{}» y «{}» usan el mismo puerto"

msgid "This forward is already in the list"
msgstr "Este reenvío ya está en la lista"

msgid "Port {} is already used by another forward in this tab: {}"
msgstr "El puerto {} ya lo usa otro reenvío de esta pestaña: {}"

msgid "ssh did not explain the error"
msgstr "ssh no explicó el error"

msgid "the port is already in use"
msgstr "el puerto ya está en uso"

msgid "ports below 1024 can only be opened by the administrator"
msgstr "solo el administrador puede abrir puertos por debajo de 1024"

msgid "{}: {}"
msgstr "{}: {}"

msgid "The forward was interrupted by an internal error"
msgstr "Un error interno interrumpió el reenvío"

msgid "Port forwarding"
msgstr "Reenvío de puertos"

msgid "Waiting…"
msgstr "Esperando…"

msgid "Waiting for login"
msgstr "Esperando el inicio de sesión"

msgid "Setting up…"
msgstr "Configurando…"

msgid "Active"
msgstr "Activo"

msgid "Failed: {}"
msgstr "Error: {}"

msgid "A port on this computer leads to a host and port reachable from the server."
msgstr "Un puerto de este equipo lleva a un host y puerto accesibles desde el servidor."

msgid "Port on this computer"
msgstr "Puerto en este equipo"

msgid "Host as seen from the server"
msgstr "Host (visto desde el servidor)"

msgid "A port on the server leads to a host and port reachable from this computer."
msgstr "Un puerto del servidor lleva a un host y puerto accesibles desde este equipo."

msgid "Port on the server"
msgstr "Puerto en el servidor"

msgid "Host as seen from this computer"
msgstr "Host (visto desde este equipo)"

msgid "A SOCKS proxy on this computer: programs that use it reach the network through the server."
msgstr "Un proxy SOCKS en este equipo: los programas que lo usan salen a la red a través del servidor."

msgid "SOCKS port on this computer"
msgstr "Puerto SOCKS en este equipo"

msgid "Forwards"
msgstr "Reenvíos"

msgid "Forwards go through this tab’s SSH connection and are shared with other tabs to {}. They stop when the connection closes and are set up again after you reconnect."
msgstr "Los reenvíos pasan por la conexión SSH de esta pestaña y se comparten con las demás pestañas de {}. Se detienen cuando se cierra la conexión y se vuelven a configurar al reconectar."

msgid "New Forward"
msgstr "Nuevo reenvío"

msgid "Listen address (optional)"
msgstr "Dirección en la que escuchar (opcional)"

msgid "Empty: only connections from the same machine (localhost). * means all interfaces. Write IPv6 addresses in square brackets, for example [::1]."
msgstr "Vacío: solo conexiones desde la misma máquina (localhost). * significa todas las interfaces. Escribe las direcciones IPv6 entre corchetes, por ejemplo [::1]."

msgid "Destination port"
msgstr "Puerto de destino"

msgid "Save with Connection"
msgstr "Guardar en la conexión"

msgid "Set up automatically whenever “{}” connects"
msgstr "Configurar automáticamente cada vez que se conecte «{}»"

msgid "Add Forward"
msgstr "Añadir reenvío"

msgid "Port Forwarding"
msgstr "Reenvío de puertos"

msgid "No forwards yet"
msgstr "Todavía no hay reenvíos"

msgid "Add one below, for example to open a web app or a database from the server on this computer."
msgstr "Añade uno abajo, por ejemplo para abrir en este equipo una aplicación web o una base de datos del servidor."

msgid "Copy {}"
msgstr "Copiar {}"

msgid "Open in Browser"
msgstr "Abrir en el navegador"

msgid "Could not open the browser: {}"
msgstr "No se pudo abrir el navegador: {}"

msgid "Try Again"
msgstr "Reintentar"

msgid "Saved with “{}”: set up automatically when it connects"
msgstr "Guardado en «{}»: se configura automáticamente al conectar"

msgid "Save with “{}”"
msgstr "Guardar en «{}»"

msgid "Port Forwarding for This Tab…"
msgstr "Reenvío de puertos de esta pestaña…"

msgid "The window is closing"
msgstr "La ventana se está cerrando"

msgid "Port forwards (optional)"
msgstr "Reenvío de puertos (opcional)"

msgid "Set up automatically after login, as in ssh: -L 8080:localhost:80 (a port here leads to a host seen from the server), -R 9000:localhost:3000 (a port on the server leads here), -D 1080 (SOCKS proxy). Separate several with commas."
msgstr "Se configuran automáticamente tras iniciar sesión y se escriben como en ssh: -L 8080:localhost:80 (un puerto de aquí lleva a un host visto desde el servidor), -R 9000:localhost:3000 (un puerto del servidor lleva aquí), -D 1080 (proxy SOCKS). Separa varios con comas."

msgid "The saved connection “{}” was renamed or deleted, so the forwards were not saved in it"
msgstr "La conexión guardada «{}» se renombró o eliminó, así que los reenvíos no se guardaron en ella"

msgid "Split Terminal Right"
msgstr "Dividir terminal a la derecha"

msgid "Split Terminal Down"
msgstr "Dividir terminal hacia abajo"

msgid "Close Current Terminal"
msgstr "Cerrar el terminal actual"

msgid "Reconnect first: the tab is not connected"
msgstr "Primero vuelve a conectar: la pestaña no está conectada"

msgid "This is the only terminal in the tab"
msgstr "Es el único terminal de la pestaña"

msgid "A split terminal lost its connection and was closed"
msgstr "Uno de los terminales de la pestaña perdió la conexión y se cerró"

msgid "All connections from the file are already in the list."
msgstr "Todas las conexiones del archivo ya están en la lista."

msgid "Already in the list and skipped: {}"
msgstr "Ya estaban en la lista y se omitieron: {}"

msgid "Connections Imported"
msgstr "Conexiones importadas"

msgid "Connections added: {}"
msgstr "Conexiones añadidas: {}"

msgid "Connections exported: {} (passwords are never included)"
msgstr "Conexiones exportadas: {} (las contraseñas nunca se incluyen)"

msgid "Could Not Import Connections"
msgstr "No se pudieron importar las conexiones"

msgid "Could not read {}: {}"
msgstr "No se pudo leer {}: {}"

msgid "Could not write {}: {}"
msgstr "No se pudo escribir {}: {}"

msgid "Export Connections"
msgstr "Exportar conexiones"

msgid "Export Connections…"
msgstr "Exportar conexiones…"

msgid "Import Connections"
msgstr "Importar conexiones"

msgid "Import Connections…"
msgstr "Importar conexiones…"

msgid "The file has a connection without an address"
msgstr "El archivo tiene una conexión sin dirección"

msgid "The file has a folder without a name"
msgstr "El archivo tiene una carpeta sin nombre"

msgid "The file has an entry that is not an object"
msgstr "El archivo tiene una entrada que no es un objeto"

msgid "The file is an ssh config: only the host address, user and port were taken. Keys, ProxyJump and other options stay in that file."
msgstr "El archivo es una configuración de ssh: solo se tomaron la dirección del host, el usuario y el puerto. Las claves, ProxyJump y otras opciones se quedan en ese archivo."

msgid "The file is neither an sshdeck export nor an ssh config with Host entries"
msgstr "El archivo no es ni una exportación de sshdeck ni una configuración de ssh con entradas Host"

msgid "The file is not valid JSON: {}"
msgstr "El archivo no es un JSON válido: {}"

msgid "The file was made by a newer version of sshdeck; update the app to import it"
msgstr "El archivo se creó con una versión más reciente de sshdeck; actualiza la aplicación para importarlo"

msgid "There are no saved connections to export"
msgstr "No hay conexiones guardadas para exportar"

msgid "This JSON file is not an sshdeck connections export"
msgstr "Este archivo JSON no es una exportación de conexiones de sshdeck"

msgid "Waiting for login in another terminal…"
msgstr "Esperando el inicio de sesión en otro terminal…"

msgid "Press Enter to log in here instead."
msgstr "Pulse Intro para iniciar sesión aquí."

msgid "The other login did not complete — logging in here."
msgstr "El otro inicio de sesión no se completó; se inicia sesión aquí."
